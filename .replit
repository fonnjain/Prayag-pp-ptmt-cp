modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["google-sheet:1.0.0", "google-drive:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 21470
externalPort = 3000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
ANTHROPIC_MODEL_FAST = "claude-sonnet-4-6"
ANTHROPIC_MODEL_DEEP = "claude-opus-4-8"
MAX_TOKENS_FAST = "1500"
MAX_TOKENS_DEEP = "4000"
